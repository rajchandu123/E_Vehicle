{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private EV driver profile and preferences isolated per authenticated user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "city": { "type": "string", "minLength": 2, "maxLength": 50 },
        "preferredSafetyBufferPercent": { "type": "number" },
        "preferredPreset": {
          "type": "string",
          "enum": ["balanced", "fastest", "cheapest", "most_reliable", "custom"]
        },
        "units": { "type": "string", "enum": ["metric", "imperial"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "name",
        "email",
        "city",
        "preferredSafetyBufferPercent",
        "preferredPreset",
        "units",
        "createdAt",
        "updatedAt"
      ]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Electric vehicle specification owned by a registered user.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "make": { "type": "string", "minLength": 1, "maxLength": 40 },
        "model": { "type": "string", "minLength": 1, "maxLength": 50 },
        "variant": { "type": "string", "minLength": 1, "maxLength": 60 },
        "year": { "type": "integer" },
        "registrationNumber": { "type": "string", "minLength": 3, "maxLength": 24 },
        "usableKwh": { "type": "number" },
        "nominalKwh": { "type": "number" },
        "efficiencyWhPerKm": { "type": "number" },
        "connectors": { "type": "array" },
        "maxDcChargeKw": { "type": "number" },
        "maxAcChargeKw": { "type": "number" },
        "odometerKm": { "type": "number" },
        "sohPercent": { "type": "number" },
        "cycleCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "make",
        "model",
        "variant",
        "year",
        "registrationNumber",
        "usableKwh",
        "nominalKwh",
        "efficiencyWhPerKm",
        "connectors",
        "maxDcChargeKw",
        "maxAcChargeKw",
        "odometerKm",
        "sohPercent",
        "cycleCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Station": {
      "title": "Station",
      "description": "Real charging station record synced from OpenStreetMap Overpass or verified operator input.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "operator": { "type": "string", "minLength": 1, "maxLength": 80 },
        "corridorSegment": { "type": "string", "minLength": 2, "maxLength": 40 },
        "kmFromBengaluru": { "type": "number" },
        "address": { "type": "string", "minLength": 2, "maxLength": 240 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "status": { "type": "string", "enum": ["online", "degraded", "offline"] },
        "pricePerKwhInr": { "type": "number" },
        "open24x7": { "type": "boolean" },
        "historicalSuccessCount": { "type": "integer" },
        "historicalFailureCount": { "type": "integer" },
        "downtimeHoursLast30d": { "type": "number" },
        "source": { "type": "string", "enum": ["osm_overpass", "community_verified"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "operator",
        "corridorSegment",
        "kmFromBengaluru",
        "address",
        "lat",
        "lng",
        "status",
        "pricePerKwhInr",
        "open24x7",
        "historicalSuccessCount",
        "historicalFailureCount",
        "downtimeHoursLast30d",
        "source",
        "updatedAt"
      ]
    },
    "StationCheckIn": {
      "title": "StationCheckIn",
      "description": "Driver reliability check-in linked to a specific charging station.",
      "type": "object",
      "properties": {
        "stationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "outcome": { "type": "string", "enum": ["worked", "not_working"] },
        "issueType": {
          "type": "string",
          "enum": ["none", "charger_offline", "connector_damaged", "payment_failed", "slow_speed", "occupied_ice"]
        },
        "comment": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stationId", "userId", "userName", "outcome", "issueType", "comment", "createdAt"]
    },
    "TripRecord": {
      "title": "TripRecord",
      "description": "Logged EV trip energy and efficiency record owned by a user.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "maxLength": 24 },
        "origin": { "type": "string", "minLength": 2, "maxLength": 100 },
        "destination": { "type": "string", "minLength": 2, "maxLength": 100 },
        "distanceKm": { "type": "number" },
        "energyUsedKwh": { "type": "number" },
        "costInr": { "type": "number" },
        "avgEfficiencyWhKm": { "type": "number" },
        "ecoScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "vehicleId",
        "date",
        "origin",
        "destination",
        "distanceKm",
        "energyUsedKwh",
        "costInr",
        "avgEfficiencyWhKm",
        "ecoScore",
        "createdAt"
      ]
    },
    "ServiceBooking": {
      "title": "ServiceBooking",
      "description": "EV workshop booking or roadside assistance dispatch owned by a user.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "centreId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "centreName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "serviceType": { "type": "string", "minLength": 2, "maxLength": 100 },
        "preferredDate": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 400 },
        "isEmergency": { "type": "boolean" },
        "status": { "type": "string", "enum": ["requested", "confirmed", "dispatched", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "vehicleId",
        "centreId",
        "centreName",
        "serviceType",
        "preferredDate",
        "notes",
        "isEmergency",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClaimRecord": {
      "title": "ClaimRecord",
      "description": "EV insurance claim record owned by a user.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policyNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "insurerName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "incidentType": {
          "type": "string",
          "enum": ["battery_thermal", "charger_surge", "collision", "roadside_tow", "glass_body"]
        },
        "incidentDate": { "type": "string", "maxLength": 24 },
        "description": { "type": "string", "minLength": 10, "maxLength": 600 },
        "estimatedAmountInr": { "type": "number" },
        "documents": { "type": "array" },
        "status": { "type": "string", "enum": ["submitted", "survey_assigned", "approved", "settled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "vehicleId",
        "policyNumber",
        "insurerName",
        "incidentType",
        "incidentDate",
        "description",
        "estimatedAmountInr",
        "documents",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PassportEvent": {
      "title": "PassportEvent",
      "description": "SHA-256 hash-chained EV Digital Passport record owned by a user.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": {
          "type": "string",
          "enum": ["ownership_registered", "charging_session", "service_record", "battery_snapshot", "insurance_claim"]
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "odometerKm": { "type": "number" },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 2, "maxLength": 400 },
        "prevHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "hash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "vehicleId",
        "type",
        "timestamp",
        "odometerKm",
        "title",
        "summary",
        "prevHash",
        "hash",
        "createdAt"
      ]
    },
    "BatterySnapshot": {
      "title": "BatterySnapshot",
      "description": "User-recorded battery State-of-Health calibration snapshot.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "month": { "type": "string", "minLength": 3, "maxLength": 20 },
        "sohPercent": { "type": "number" },
        "dcFastChargeRatio": { "type": "number" },
        "avgTempC": { "type": "number" },
        "cycles": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "vehicleId", "month", "sohPercent", "dcFastChargeRatio", "avgTempC", "cycles", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile isolated to the authenticated owner."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "User-owned electric vehicles."
    },
    "/stations/{stationId}": {
      "schema": { "$ref": "#/entities/Station" },
      "description": "Real charging stations along the Bengaluru-Mysuru corridor."
    },
    "/stations/{stationId}/checkIns/{checkInId}": {
      "schema": { "$ref": "#/entities/StationCheckIn" },
      "description": "Community reliability check-ins for each charging station."
    },
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/TripRecord" },
      "description": "User trip history and efficiency records."
    },
    "/serviceBookings/{bookingId}": {
      "schema": { "$ref": "#/entities/ServiceBooking" },
      "description": "User EV service bookings and roadside assistance requests."
    },
    "/claims/{claimId}": {
      "schema": { "$ref": "#/entities/ClaimRecord" },
      "description": "User EV insurance claims."
    },
    "/passportEvents/{eventId}": {
      "schema": { "$ref": "#/entities/PassportEvent" },
      "description": "Tamper-evident SHA-256 Digital Passport events."
    },
    "/batterySnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/BatterySnapshot" },
      "description": "User battery health snapshots."
    }
  }
}
